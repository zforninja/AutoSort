# AutoSort — Windower 4 Lua add-on

# User-specific saved settings and per-character rule files. Do not commit
# personal config. Keep the data/ folder itself via .gitkeep.
data/settings.json
data/*.lua
!data/.gitkeep

# Windower / Lua runtime artifacts
*.log
*.bak
*.tmp
*.swp

# Editor / OS cruft
.vscode/
.idea/
*.sublime-*
.DS_Store
Thumbs.db
desktop.ini

# Compiled Lua (if any tooling produces it)
*.luac
